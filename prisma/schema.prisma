generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  emoji     String   @default("🌸")
  createdAt DateTime @default(now())
  words     Word[]
  passages  Passage[]
}

model Word {
  id           Int       @id @default(autoincrement())
  word         String
  type         String?   // Loại từ: Noun, Verb...
  meaning      String    // Nghĩa tiếng Việt
  definition   String?   // Định nghĩa chi tiết
  example      String?
  note         String?
  topicId      Int
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  // Lặp lại ngắt quãng (1 - 2 - 4 - 7 ngày...)
  stage        Int       @default(0)
  nextReviewAt DateTime  @default(now())
  lastReviewAt DateTime?
  correctCount Int       @default(0)
  wrongCount   Int       @default(0)
  attempts     QuizAttempt[]

  @@index([topicId])
  @@index([nextReviewAt])
}

// Mỗi lần ôn (flashcard) hoặc làm test đều được ghi lại để tính streak & mục tiêu ngày
model QuizAttempt {
  id        Int      @id @default(autoincrement())
  wordId    Int
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  mode      String   // "review" | "test"
  correct   Boolean
  answer    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Passage {
  id              Int              @id @default(autoincrement())
  title           String
  content         String           // Đoạn văn tiếng Anh đầy đủ
  translation     String?          // Bản dịch tiếng Việt
  topicId         Int?
  topic           Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  level           String           @default("Intermediate") // Beginner | Intermediate | Advanced
  tags            String?          // "IELTS, Speech, Daily, v.v."
  timesPracticed  Int              @default(0)
  lastPracticedAt DateTime?
  bestScore       Int?             // Điểm cao nhất 0-100
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        PassageSession[]

  @@index([topicId])
  @@index([createdAt])
}

model PassageSession {
  id          Int      @id @default(autoincrement())
  passageId   Int
  passage     Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  mode        String   // "listen" | "vanish" | "typing" | "scramble" | "recite"
  score       Int      // 0 - 100
  accuracy    Float?
  wpm         Int?
  timeSeconds Int?
  createdAt   DateTime @default(now())

  @@index([passageId])
  @@index([createdAt])
}

